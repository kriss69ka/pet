{
  "compilerOptions": {
    // включает композитную сборку проекта
    "composite": true,
    // какой модульный формат будет использоваться при компиляции
    "module": "esnext",
    // Определяет стратегию разрешения модулей. В данном случае, используется разрешение модулей Node.js
    "moduleResolution": "node",
    // версия ECMAScript для которой будет генерироваться JavaScript код
    "target": "ESNext",
    // Эта опция управляет тем, как TypeScript компилирует поля классов.
    "useDefineForClassFields": true,
    // Определяет базовый каталог, относительно которого будут разрешаться неабсолютные модули
    "baseUrl": "src",
    // Перечисляет стандартные библиотеки, которые будут доступны в проекте
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // запрещено включать файлы JavaScript в проект
    "allowJs": false,
    // проверять объявления типов в .d.ts files.
    "skipLibCheck": false,
    // Определяет, следует ли включать специальную поддержку для импортов и экспортов CommonJS
    "esModuleInterop": false,
    // Позволяет импортировать неявные экспорты из модулей, которые не экспортируют значения по умолчанию
    "allowSyntheticDefaultImports": true,
    // Включает все строгие проверки TypeScript.
    "strict": true,
    // при импорте файлов учитывать регистр символов
    "forceConsistentCasingInFileNames": true,
    // Позволяет импортировать JSON файлы
    "resolveJsonModule": true,
    // Запрещает компилятору TypeScript генерировать файлы JavaScript
    "noEmit": true,
    // Указывает, как следует обрабатывать JSX
    "jsx": "react-jsx"
  },
  // в какой директории будет компиляция тс
  "include": ["src"],
}